<Window x:Class="OISblocca.UI.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autorizzazione docente" Height="300" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shake Animation per password errata -->
        <Storyboard x:Key="ShakeAnimation">
            <DoubleAnimation Storyboard.TargetName="CardBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="12" Duration="0:0:0.06" AutoReverse="True" RepeatBehavior="3x" />
        </Storyboard>
    </Window.Resources>

    <Border x:Name="CardBorder" Background="#1E1F24" CornerRadius="16" BorderBrush="#353842" BorderThickness="1.2" Margin="10">
        <Border.RenderTransform>
            <TranslateTransform X="0" Y="0"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="270" ShadowDepth="6" Color="#000000" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Icon & Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="40" Height="40" CornerRadius="20" Background="#263238" Margin="0,0,14,0">
                    <Path Width="18" Height="18" Fill="#00E676" Stretch="Uniform"
                          Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,7A3,3 0 0,1 15,10A3,3 0 0,1 12,13A3,3 0 0,1 9,10A3,3 0 0,1 12,7Z"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Autorizzazione docente" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Accesso protetto per i docenti responsabili" FontSize="11.5" Foreground="#9E9E9E"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Inserisci la password docente per accedere al pannello:"
                       FontSize="13" Foreground="#E0E0E0" Margin="0,0,0,12"/>

            <!-- Password Box -->
            <Border Grid.Row="2" Background="#282A30" CornerRadius="8" BorderBrush="#3E424D" BorderThickness="1" Height="42" Margin="0,0,0,18">
                <PasswordBox x:Name="txtPassword" Background="Transparent" Foreground="#FFFFFF"
                             FontSize="15" BorderThickness="0" VerticalAlignment="Center"
                             Padding="12,4,12,4" KeyDown="TxtPassword_KeyDown"/>
            </Border>

            <!-- Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblError" VerticalAlignment="Center" Foreground="#FF5252"
                           FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" Text="Password errata!"/>

                <Button Grid.Column="1" Content="Annulla" Width="90" Height="36"
                        Style="{StaticResource ModernButtonStyle}" Background="#373940"
                        Margin="0,0,10,0" Click="BtnCancel_Click"/>

                <Button Grid.Column="2" Content="Accedi" Width="100" Height="36"
                        Style="{StaticResource ModernButtonStyle}" Background="#00C853"
                        Click="BtnOk_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>