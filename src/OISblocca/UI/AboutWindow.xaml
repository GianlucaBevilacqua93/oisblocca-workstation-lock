<Window x:Class="OISblocca.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informazioni e contatti" Height="430" Width="530"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1F24" CornerRadius="16" BorderBrush="#353842" BorderThickness="1.2" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="270" ShadowDepth="6" Color="#000000" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="OISblocca v2.0" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Olimpiadi di Informatica a Squadre (OIS)" FontSize="12.5" Foreground="#00E676" FontWeight="SemiBold"/>
                <TextBlock Text="Interfaccia moderna e intuitiva per la gestione sicura delle postazioni degli studenti."
                           FontSize="12" Foreground="#9E9E9E" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Authors Card -->
            <Border Grid.Row="1" Background="#25272E" CornerRadius="12" BorderBrush="#333742" BorderThickness="1" Padding="18">
                <StackPanel>
                    <TextBlock Text="Autori e contatti ufficiali:" FontSize="13" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,12"/>

                    <!-- Prof. Quarto -->
                    <Border Background="#1C1D22" CornerRadius="8" Padding="12,10,12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="17" Background="#1B5E20" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Path Width="16" Height="16" Fill="#00E676" Stretch="Uniform"
                                      Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Prof. Quarto" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="profquarto@gmail.com" FontSize="12" Foreground="#81D4FA"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Invia email" Width="85" Height="30"
                                    Style="{StaticResource ModernButtonStyle}" Background="#0288D1"
                                    Click="BtnEmailQuarto_Click"/>
                        </Grid>
                    </Border>

                    <!-- Prof. Bevilacqua -->
                    <Border Background="#1C1D22" CornerRadius="8" Padding="12,10,12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="17" Background="#0D47A1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Path Width="16" Height="16" Fill="#40C4FF" Stretch="Uniform"
                                      Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Prof. Bevilacqua" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="gianlucagennaro.bevilacqua@scuola.istruzione.it" FontSize="11" Foreground="#81D4FA"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Invia email" Width="85" Height="30"
                                    Style="{StaticResource ModernButtonStyle}" Background="#0288D1"
                                    Click="BtnEmailBevilacqua_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Portale ufficiale OIS: https://oisquadre.it" FontSize="11.5" Foreground="#B0BEC5" Cursor="Hand" MouseDown="LnkWeb_MouseDown"/>
                </StackPanel>
            </Border>

            <!-- Bottom Close -->
            <Button Grid.Row="2" Content="Chiudi" Width="100" Height="34"
                    HorizontalAlignment="Right" Margin="0,16,0,0"
                    Style="{StaticResource ModernButtonStyle}" Background="#37474F"
                    Click="BtnClose_Click"/>
        </Grid>
    </Border>
</Window>