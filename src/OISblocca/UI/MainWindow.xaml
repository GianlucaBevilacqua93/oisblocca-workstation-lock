<Window x:Class="OISblocca.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OISblocca v2.0 - Olimpiadi a squadre" Height="780" Width="1080"
        MinHeight="680" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#18191D" Foreground="#FFFFFF"
        FontFamily="Segoe UI, Segoe UI Variable Display">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Switch Style for Include/Exclude -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="BackgroundBorder" Width="44" Height="24" CornerRadius="12" Background="#424652" BorderThickness="0">
                                <Ellipse x:Name="Thumb" Width="18" Height="18" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="#FFFFFF">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#00C853"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header bar -->
            <RowDefinition Height="Auto"/>
            <!-- Action Ribbon -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Split -->
            <RowDefinition Height="*"/>
            <!-- Footer Bar -->
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER BAR ================= -->
        <Border Grid.Row="0" Background="#202227" BorderBrush="#2C2F36" BorderThickness="0,0,0,1" Padding="20,14,20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Vector Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#1B5E20" Margin="0,0,14,0">
                        <Path Width="20" Height="20" Fill="#00E676" Stretch="Uniform"
                              Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,7A3,3 0 0,1 15,10A3,3 0 0,1 12,13A3,3 0 0,1 9,10A3,3 0 0,1 12,7Z"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OISblocca" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border Background="#263238" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v2.0" FontSize="10.5" FontWeight="Bold" Foreground="#81D4FA"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Protezione della postazione e gestione siti per gare OIS" FontSize="11.5" Foreground="#9E9E9E"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badge Pill -->
                <Border x:Name="pnlStatusPill" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="20" Background="#1B5E20" Padding="16,6,16,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="dotStatusPill" Width="10" Height="10" Fill="#00E676" Margin="0,0,8,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#00E676" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="lblStatusPill" Text="Modalità normale (internet libero)" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </StackPanel>
                </Border>

                <!-- Quick Buttons (Tray & About & Web Check) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernButtonStyle}" Background="#1565C0" Margin="0,0,8,0" Click="BtnTestOis_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Fill="White" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,4.07C7.05,4.56 4,7.92 4,12C4,12.7 4.1,13.38 4.29,14.03L9,9.32V8A1,1 0 0,1 10,7H11V4.07M17.9,7.66C17.34,6.77 16.59,6 15.7,5.4V6A2,2 0 0,1 13.7,8H12V10A1,1 0 0,1 11,11H9V13H13A1,1 0 0,1 14,14V17H15A3,3 0 0,0 18,14V12.92C19.26,11.5 20,9.84 20,8C20,7.89 20,7.77 19.97,7.66H17.9Z"/>
                            <TextBlock Text="Verifica requisiti gara" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButtonStyle}" Background="#455A64" Margin="0,0,8,0" Click="BtnChangePassword_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Fill="White" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10A2,2 0 0,1 9,12A2,2 0 0,1 7,14M12.65,10C11.83,7.67 9.61,6 7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.61,18 11.83,16.33 12.65,14H17V18H21V14H23V10H12.65Z"/>
                            <TextBlock Text="Modifica password" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButtonStyle}" Background="#3E2723" Margin="0,0,8,0" Click="BtnAbout_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Fill="White" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
                            <TextBlock Text="Informazioni e contatti" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButtonStyle}" Background="#37474F" Click="BtnMinimizeTray_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Fill="White" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M20,14H4V10H20"/>
                            <TextBlock Text="Riduci a icona" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2. ACTION RIBBON ================= -->
        <Border Grid.Row="1" Background="#1B1C20" BorderBrush="#2A2C34" BorderThickness="0,0,0,1" Padding="20,12,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Primary Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnLock" Width="215" Height="42"
                            Style="{StaticResource ModernButtonStyle}" Background="#C62828"
                            FontSize="13" Margin="0,0,12,0" Click="BtnLock_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="16" Height="16" Fill="White" Stretch="Uniform" Margin="0,0,8,0"
                                  Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.89,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"/>
                            <TextBlock Text="Attiva modalità gara" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnUnlock" Width="195" Height="42"
                            Style="{StaticResource ModernButtonStyle}" Background="#2E7D32"
                            FontSize="13" IsEnabled="False" Click="BtnUnlock_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="16" Height="16" Fill="White" Stretch="Uniform" Margin="0,0,8,0"
                                  Data="M18,8H17V6A5,5 0 0,0 7,6H9A3,3 0 0,1 15,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8M12,17A2,2 1,1 14,15A2,2 0 0,1 12,17Z"/>
                            <TextBlock Text="Disattiva blocco" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Middle Settings -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                    <CheckBox x:Name="chkStartup" Content="Avvia automaticamente all'accensione del computer"
                              Foreground="#B0BEC5" FontSize="12.5" VerticalContentAlignment="Center"
                              Checked="ChkStartup_CheckedChanged" Unchecked="ChkStartup_CheckedChanged"/>
                </StackPanel>

                <!-- Refresh Button & Site Counter -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#24262E" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                        <TextBlock x:Name="lblSiteStats" Text="4 siti autorizzati (0 esclusi)" FontSize="12" Foreground="#E0E0E0" FontWeight="SemiBold"/>
                    </Border>
                    <Button Style="{StaticResource ModernButtonStyle}" Background="#0277BD" Click="BtnRefreshProbes_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="13" Height="13" Fill="White" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                            <TextBlock Text="Aggiorna stato siti" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 3. MAIN CONTENT SPLIT ================= -->
        <Grid Grid.Row="2" Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: SITI CONSENTITI & GESTIONE -->
            <Border Grid.Column="0" Background="#202227" CornerRadius="12" BorderBrush="#2C2F36" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header Section -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Siti web consentiti durante la gara" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Abilita o disabilita con un clic" FontSize="11.5" Foreground="#78909C" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Add New Domain Bar -->
                    <Border Grid.Row="1" Background="#26282F" CornerRadius="10" BorderBrush="#353842" BorderThickness="1" Padding="10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtNewDomain" Background="#1C1D22" Foreground="#FFFFFF"
                                     BorderThickness="1" BorderBrush="#3D414D" Padding="10,6"
                                     FontSize="12.5" Margin="0,0,8,0" VerticalAlignment="Center"
                                     KeyDown="TxtNewDomain_KeyDown"/>

                            <TextBox x:Name="txtNewDesc" Grid.Column="1" Background="#1C1D22" Foreground="#FFFFFF"
                                     BorderThickness="1" BorderBrush="#3D414D" Padding="10,6"
                                     FontSize="12.5" Margin="0,0,8,0" VerticalAlignment="Center"
                                     KeyDown="TxtNewDomain_KeyDown"/>

                            <Button Grid.Column="2" Content="+ Aggiungi sito" Height="34"
                                    Style="{StaticResource ModernButtonStyle}" Background="#00C853"
                                    Click="BtnAddSite_Click"/>
                        </Grid>
                    </Border>

                    <!-- List of Sites Cards -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="icSites">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#25272E" CornerRadius="10" BorderBrush="#333742" BorderThickness="1" 
                                            Padding="14,10" Margin="0,0,0,8" Opacity="{Binding StatusOpacity}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Status Indicator Circle -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Domain & Description -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Latency badge -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Include/Exclude Toggle -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Delete button -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Status Dot with Glow -->
                                            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="{Binding StatusMessage}">
                                                <Ellipse Width="14" Height="14" Fill="{Binding StatusBrush}">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="8" Color="{Binding StatusBrush.Color}" Opacity="0.8"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Grid>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Domain}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    <Border Background="#1C1D22" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BadgeDisplay}" FontSize="11" Foreground="#90CAF9"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#9E9E9E" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Latency -->
                                            <Border Grid.Column="2" Background="#1C1D22" CornerRadius="6" Padding="8,4" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="10" Height="10" Fill="#FFA000" Stretch="Uniform" Margin="0,0,4,0"
                                                          Data="M11,15H6L13,1V9H18L11,23V15Z"/>
                                                    <TextBlock Text="{Binding LatencyDisplay}" FontSize="11" Foreground="#CFD8DC" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Toggle Switch (Include/Exclude) -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <CheckBox IsChecked="{Binding IsEnabled}" Style="{StaticResource ModernToggleSwitch}"
                                                          Click="ChkSiteToggle_Click" ToolTip="Abilita o escludi questo sito dalla navigazione"/>
                                            </StackPanel>

                                            <!-- Vector Trash Can Delete Button -->
                                            <Button Grid.Column="4" Width="32" Height="32" Padding="0"
                                                    Style="{StaticResource ModernButtonStyle}" Background="#2E2428"
                                                    BorderBrush="#4A282E" BorderThickness="1"
                                                    Click="BtnDeleteSite_Click" ToolTip="Rimuovi questo sito dall'elenco">
                                                <Path Width="14" Height="14" Fill="#FF5252" Stretch="Uniform"
                                                      Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: LIVE ACTIVITY LOG -->
            <Border Grid.Column="2" Background="#202227" CornerRadius="12" BorderBrush="#2C2F36" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Registro attività del sistema" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Button Content="Svuota" HorizontalAlignment="Right" FontSize="11" Padding="8,3"
                                Style="{StaticResource ModernButtonStyle}" Background="#373940" Click="BtnClearLogs_Click"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#17181C" CornerRadius="8" BorderBrush="#292B33" BorderThickness="1" Padding="10">
                        <TextBox x:Name="txtLogs" Background="Transparent" Foreground="#ECEFF1"
                                 BorderThickness="0" FontFamily="Consolas" FontSize="11.5"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 4. FOOTER BAR ================= -->
        <Border Grid.Row="3" Background="#1B1C20" BorderBrush="#262830" BorderThickness="0,1,0,0" Padding="20,0,20,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Autori: " FontSize="11.5" FontWeight="Bold" Foreground="#78909C"/>
                    <TextBlock Text="Prof. Quarto (profquarto@gmail.com)" FontSize="11.5" Foreground="#81D4FA" Cursor="Hand" MouseDown="LnkQuarto_MouseDown"/>
                    <TextBlock Text="  e  " FontSize="11.5" Foreground="#78909C"/>
                    <TextBlock Text="Prof. Bevilacqua (gianlucagennaro.bevilacqua@scuola.istruzione.it)" FontSize="11.5" Foreground="#81D4FA" Cursor="Hand" MouseDown="LnkBevilacqua_MouseDown"/>
                </StackPanel>

                <TextBlock Text="Olimpiadi di Informatica a Squadre • Versione 2.0" FontSize="11" Foreground="#546E7A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>