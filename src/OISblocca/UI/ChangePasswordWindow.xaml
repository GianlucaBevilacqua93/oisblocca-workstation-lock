<Window x:Class="OISblocca.UI.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifica password docente" Height="410" Width="470"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="ShakeAnimation">
            <DoubleAnimation Storyboard.TargetName="CardBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="10" Duration="0:0:0.06" AutoReverse="True" RepeatBehavior="3x" />
        </Storyboard>
    </Window.Resources>

    <Border x:Name="CardBorder" Background="#1E1F24" CornerRadius="16" BorderBrush="#353842" BorderThickness="1.2" Margin="10">
        <Border.RenderTransform>
            <TranslateTransform X="0" Y="0"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="270" ShadowDepth="6" Color="#000000" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Icon & Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="40" Height="40" CornerRadius="20" Background="#263238" Margin="0,0,14,0">
                    <Path Width="18" Height="18" Fill="#00E676" Stretch="Uniform"
                          Data="M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10A2,2 0 0,1 9,12A2,2 0 0,1 7,14M12.65,10C11.83,7.67 9.61,6 7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.61,18 11.83,16.33 12.65,14H17V18H21V14H23V10H12.65Z"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Modifica password docente" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Sostituisci la password predefinita di accesso" FontSize="11.5" Foreground="#9E9E9E"/>
                </StackPanel>
            </StackPanel>

            <!-- Current Password -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Password attuale:" FontSize="12.5" Foreground="#CFD8DC" Margin="0,0,0,4"/>
                <Border Background="#282A30" CornerRadius="8" BorderBrush="#3E424D" BorderThickness="1" Height="38">
                    <PasswordBox x:Name="txtCurrentPassword" Background="Transparent" Foreground="#FFFFFF"
                                 FontSize="14" BorderThickness="0" VerticalAlignment="Center"
                                 Padding="10,4,10,4" KeyDown="Input_KeyDown"/>
                </Border>
            </StackPanel>

            <!-- New Password -->
            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Nuova password (almeno 4 caratteri):" FontSize="12.5" Foreground="#CFD8DC" Margin="0,0,0,4"/>
                <Border Background="#282A30" CornerRadius="8" BorderBrush="#3E424D" BorderThickness="1" Height="38">
                    <PasswordBox x:Name="txtNewPassword" Background="Transparent" Foreground="#FFFFFF"
                                 FontSize="14" BorderThickness="0" VerticalAlignment="Center"
                                 Padding="10,4,10,4" KeyDown="Input_KeyDown"/>
                </Border>
            </StackPanel>

            <!-- Confirm New Password -->
            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <TextBlock Text="Conferma nuova password:" FontSize="12.5" Foreground="#CFD8DC" Margin="0,0,0,4"/>
                <Border Background="#282A30" CornerRadius="8" BorderBrush="#3E424D" BorderThickness="1" Height="38">
                    <PasswordBox x:Name="txtConfirmPassword" Background="Transparent" Foreground="#FFFFFF"
                                 FontSize="14" BorderThickness="0" VerticalAlignment="Center"
                                 Padding="10,4,10,4" KeyDown="Input_KeyDown"/>
                </Border>
            </StackPanel>

            <!-- Error message -->
            <TextBlock x:Name="lblMessage" Grid.Row="4" Margin="0,0,0,14"
                       FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap"/>

            <!-- Buttons -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Annulla" Width="90" Height="36"
                        Style="{StaticResource ModernButtonStyle}" Background="#37474F"
                        Margin="0,0,10,0" Click="BtnCancel_Click"/>

                <Button Grid.Column="2" Content="Salva password" Width="130" Height="36"
                        Style="{StaticResource ModernButtonStyle}" Background="#00C853"
                        Click="BtnSave_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>